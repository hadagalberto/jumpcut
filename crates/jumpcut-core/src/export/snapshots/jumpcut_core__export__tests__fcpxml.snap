---
source: crates/jumpcut-core/src/export/mod.rs
expression: "snapshot(ExportFormat::Fcpxml)"
---
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.10">
  <resources>
    <format id="rFmt1" name="FFVideoFormat1080p30" frameDuration="1/30s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
    <asset id="rAsset1" name="input.mp4" start="0s" duration="7/1s" hasVideo="1" hasAudio="1" format="rFmt1">
      <media-rep kind="original-media" src="file:///media/input.mp4"/>
    </asset>
  </resources>
  <library>
    <event name="jumpcut">
      <project name="input.mp4 - jumpcut">
        <sequence duration="5/1s" format="rFmt1">
          <spine>
            <asset-clip ref="rAsset1" offset="0/1s" start="0/1s" duration="2/1s" name="input.mp4 1" tcFormat="NDF">
            </asset-clip>
            <asset-clip ref="rAsset1" offset="2/1s" start="3/1s" duration="2/1s" name="input.mp4 2" tcFormat="NDF">
            </asset-clip>
            <asset-clip ref="rAsset1" offset="4/1s" start="6/1s" duration="1/1s" name="input.mp4 3" tcFormat="NDF">
            </asset-clip>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
